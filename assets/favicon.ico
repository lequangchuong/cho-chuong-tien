</head>
<body>
<div class="wrap">

  <header class="top">
    <div class="brand">
      <svg viewBox="0 0 32 32" aria-hidden="true"><path d="M3 14h26c0 8-5 14-13 14S3 22 3 14z" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linejoin="round"/><path d="M7 14c1-5 5-8 9-8s8 3 9 8" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"/></svg>
      Xin Một Bữa
    </div>
    <small>Áo rách, lòng không rách</small>
  </header>

  <section class="hero" aria-labelledby="h-hero">
    <div class="hero-text">
      <div class="tear placard-wrap"><div class="placard">
        <p class="eyebrow">Nền tảng ăn xin online · rách nhưng sạch, nghèo nhưng lịch sự</p>
        <h1 id="h-hero"><span class="l">Ăn xin online.</span><em>Bạn quét, mình no.</em></h1>
        <p class="lead">Chào bạn, mình là người đi xin. Thời đại số rồi nên mình xin bằng mã QR cho văn minh: bạn chọn món, mình ăn, ai cũng vui. Một ly trà đá thôi cũng được tính là đóng góp cho nền ẩm thực nước nhà.</p>
        <div class="placard-foot"><p class="hand">— người xin ăn phiên bản 2.0, có cả wifi</p><p class="stamp">Rách nhưng sạch</p></div>
      </div></div>
      <div class="cta-row">
        <a class="btn btn-primary" href="#moi">Mời mình ăn</a>
        <a class="btn btn-ghost" href="#hua">Mình hứa gì?</a>
      </div>
    </div>

    <div class="bowl-wrap">
      <div class="bowl-stage" id="stage">
        <svg viewBox="0 0 320 260" role="img" aria-label="Chiếc bát sứ men lam đựng cơm trắng và một quả trứng ốp la">
          <g class="steam" fill="none" stroke="var(--muted)" stroke-width="3" stroke-linecap="round">
            <path d="M120 38c-8-8 8-14 0-24"/>
            <path d="M160 30c-8-8 8-14 0-24"/>
            <path d="M200 38c-8-8 8-14 0-24"/>
          </g>
          <path d="M52 112C60 66 108 48 160 48s100 18 108 64z" fill="var(--rice)" stroke="var(--cobalt)" stroke-width="3.5" stroke-linejoin="round"/>
          <g fill="var(--line)">
            <ellipse cx="96" cy="86" rx="5" ry="2.5" transform="rotate(-25 96 86)"/>
            <ellipse cx="124" cy="72" rx="5" ry="2.5" transform="rotate(15 124 72)"/>
            <ellipse cx="112" cy="100" rx="5" ry="2.5" transform="rotate(35 112 100)"/>
            <ellipse cx="228" cy="92" rx="5" ry="2.5" transform="rotate(-30 228 92)"/>
            <ellipse cx="246" cy="104" rx="5" ry="2.5" transform="rotate(20 246 104)"/>
          </g>
          <path d="M162 68c4-14 26-18 40-10 14 8 12 24-4 28-12 3-20-2-30 0-8 2-10-8-6-18z" fill="#FFFFFF" stroke="var(--cobalt)" stroke-width="2.5" stroke-linejoin="round"/>
          <circle cx="188" cy="72" r="9" fill="var(--yolk)"/>
          <path d="M24 108h272c0 82-52 130-136 130S24 190 24 108z" fill="var(--surface)" stroke="var(--cobalt)" stroke-width="4" stroke-linejoin="round"/>
          <path d="M18 108h284" stroke="var(--cobalt)" stroke-width="9" stroke-linecap="round"/>
          <g fill="none" stroke="var(--cobalt)" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M52 150q12-18 24 0q12-18 24 0q12-18 24 0q12-18 24 0q12-18 24 0q12-18 24 0q12-18 24 0q12-18 24 0q12-18 24 0"/>
            <path d="M88 178q12-18 24 0q12-18 24 0q12-18 24 0q12-18 24 0q12-18 24 0q12-18 24 0"/>
            <path d="M112 204q12-16 24 0q12-16 24 0q12-16 24 0q12-16 24 0"/>
          </g>
          <path d="M118 236h84l-6 14h-72z" fill="var(--cobalt-soft)" stroke="var(--cobalt)" stroke-width="3.5" stroke-linejoin="round"/>
          <g transform="rotate(-8 214 176)"><rect x="190" y="156" width="46" height="38" rx="4" fill="var(--sun)" stroke="var(--cobalt)" stroke-width="2.5"/><rect x="195" y="161" width="36" height="28" rx="2" fill="none" stroke="var(--cobalt)" stroke-width="2" stroke-dasharray="4 4"/></g>
          <path d="M96 112l8 16-9 10 10 14" fill="none" stroke="var(--cobalt)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M276 108l-6 10 8 6" fill="none" stroke="var(--cobalt)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
      <p class="bowl-caption" id="caption" aria-live="polite">Bát sứt một miếng, bụng cũng trống. Chọn một món bên dưới để thả đồng xu đầu tiên.</p>
    </div>
  </section>

  <section id="moi" aria-labelledby="h-moi">
    <div class="section-head">
      <p class="eyebrow">Thực đơn mời mình</p>
      <h2 id="h-moi">Bạn muốn mời mình món gì?</h2>
      <p class="lead">Giá tham khảo cho một bữa bình dân ngoài phố. Chọn món nào cũng được, hoặc tự nhập số bạn thấy vui.</p>
    </div>

    <div class="menu" role="radiogroup" aria-label="Chọn món muốn mời">
      <label class="item">
        <input type="radio" name="mon" value="5000" data-label="Ly trà đá" data-memo="MOI MINH LY TRA DA">
        <span class="card"><span class="name">Ly trà đá</span><span class="price">5.000đ</span><span class="note">Giải khát, giải nhiệt, giải sầu.</span></span>
      </label>
      <label class="item">
        <input type="radio" name="mon" value="20000" data-label="Ổ bánh mì" data-memo="MOI MINH O BANH MI">
        <span class="card"><span class="name">Ổ bánh mì</span><span class="price">20.000đ</span><span class="note">Có thêm chút pate là hạnh phúc.</span></span>
      </label>
      <label class="item">
        <input type="radio" name="mon" value="50000" data-label="Tô phở" data-memo="MOI MINH TO PHO" checked>
        <span class="card"><span class="name">Tô phở</span><span class="price">50.000đ</span><span class="note">Nước dùng nóng, lòng người cũng ấm.</span></span>
      </label>
      <label class="item">
        <input type="radio" name="mon" value="100000" data-label="Bữa cơm đủ đầy" data-memo="MOI MINH BUA COM">
        <span class="card"><span class="name">Bữa cơm đủ đầy</span><span class="price">100.000đ</span><span class="note">Có canh, có thịt, có rau, có nụ cười.</span></span>
      </label>
      <label class="item custom">
        <input type="radio" name="mon" value="custom" data-label="Tuỳ tâm bạn" data-memo="MOI MINH AN">
        <span class="card">
          <span class="name">Tuỳ tâm</span>
          <span class="custom-field"><input id="customAmount" type="number" inputmode="numeric" min="1000" step="1000" value="30000" aria-label="Số tiền tuỳ tâm, đơn vị đồng"><span>đ</span></span>
          <span class="note">Bao nhiêu cũng quý.</span>
        </span>
      </label>
    </div>

    <div class="tear panel-wrap"><div class="panel" aria-live="polite">
      <div class="rows">
        <div class="row"><div><span class="lbl">Ngân hàng</span><span class="val" id="bank"></span></div></div>
        <div class="row"><div><span class="lbl">Chủ tài khoản</span><span class="val" id="holder"></span></div></div>
        <div class="row"><div><span class="lbl">Số tài khoản</span><span class="val" id="account"></span></div><button class="copy" type="button" data-copy="account">Sao chép</button></div>
        <div class="row"><div><span class="lbl">Số tiền</span><span class="val big" id="amount"></span></div><button class="copy" type="button" data-copy="amountRaw">Sao chép</button></div>
        <div class="row"><div><span class="lbl">Nội dung chuyển khoản</span><span class="val" id="memo"></span></div><button class="copy" type="button" data-copy="memo">Sao chép</button></div>
        <span id="amountRaw" hidden></span>
      </div>
      <div class="qr">
        <img src="data:image/png;base64," width="220" height="220" alt="Mã QR chuyển khoản VietQR của Chu Anh Phuong, Ngân hàng Bản Việt">
        <p>Mở app ngân hàng, quét mã là xong. Mã không kèm số tiền, bạn nhập theo món đã chọn nhé.</p>
      </div>
    </div></div>
    <p class="sample-note" id="sampleNote"><strong>Thông tin mẫu.</strong> Số tài khoản và tên bên trên chỉ là chỗ giữ chỗ. Hãy thay bằng thông tin chính chủ của bạn trước khi chia sẻ trang.</p>
    <div class="thanks-cta">
      <button class="btn btn-primary" type="button" id="doneBtn" aria-expanded="false" aria-controls="thanks">Mình vừa chuyển xong</button>
      <span class="hand">Chuyển xong, bạn bấm đây để nhận lời cảm ơn nho nhỏ của mình nhé.</span>
    </div>
    <div class="thanks" id="thanks" tabindex="-1" hidden aria-live="polite">
      <h3 id="thanksTitle"></h3>
      <p class="body" id="thanksBody"></p>
      <p class="vow" id="thanksVow"></p>
      <p class="sign">— Người xin ăn lịch sự nhất khu phố</p>
      <div class="actions">
        <button class="btn btn-primary" type="button" id="shareBtn2">Kể cho bạn bè nghe</button>
        <a class="btn btn-ghost" href="#moi">Xem lại thực đơn</a>
      </div>
    </div>
  </section>

  <section id="hua" class="split" aria-labelledby="h-hua">
    <div>
      <p class="eyebrow">Lời hứa của người đi xin</p>
      <h2 id="h-hua">Xin thì xin, nhưng mình xin có đạo đức.</h2>
      <ul class="promises">
        <li>
          <svg viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="14" cy="14" r="11"/><path d="M8.5 14.5l4 4 7-8"/></svg>
          <div><b>Nói thật, không vòng vo.</b><span>Không kể khổ quá đà, không bán hàng đa cấp. Cần một bữa ăn thì nói là cần một bữa ăn.</span></div>
        </li>
        <li>
          <svg viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 24S3 17.5 3 10.5A6 6 0 0 1 14 7a6 6 0 0 1 11 3.5C25 17.5 14 24 14 24z"/></svg>
          <div><b>Cảm ơn từng ly trà đá.</b><span>Mình đọc từng lời nhắn trong nội dung chuyển khoản và nhớ từng người.</span></div>
        </li>
        <li>
          <svg viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 14a10 10 0 0 1 17-7l3 3"/><path d="M24 4v6h-6"/><path d="M24 14a10 10 0 0 1-17 7l-3-3"/><path d="M4 24v-6h6"/></svg>
          <div><b>Có dư thì cho lại.</b><span>Khi khá hơn, mình mời lại một người lạ một bữa cơm. Vòng tròn tử tế cứ thế quay tiếp.</span></div>
        </li>
      </ul>
    </div>

    <div class="tear"><div class="receipt" aria-label="Hóa đơn niềm vui, tự cập nhật theo món bạn chọn">
      <h3>Hóa đơn niềm vui</h3>
      <p class="meta">Bàn: không có · Khách: người tốt bụng</p>
      <div class="line"><span class="t" id="rItem">Tô phở</span><span class="dots"></span><span class="p" id="rPrice">50.000đ</span></div>
      <div class="line"><span class="t">Lời cảm ơn chân thành ×1</span><span class="dots"></span><span class="p">0đ</span></div>
      <div class="line"><span class="t">Một nụ cười hôm nay ×1</span><span class="dots"></span><span class="p">0đ</span></div>
      <div class="line"><span class="t">Cảm giác vừa làm việc tốt ×1</span><span class="dots"></span><span class="p">0đ</span></div>
      <div class="total"><span>Bạn trả</span><strong id="rTotal">50.000đ</strong></div>
      <p class="foot">Không cần xuất hóa đơn đỏ, mình nhớ ơn bạn rồi.</p>
    </div></div>
  </section>

  <section aria-labelledby="h-help">
    <div class="section-head">
      <p class="eyebrow">Chưa tiện chuyển khoản?</p>
      <h2 id="h-help">Vẫn có ba cách giúp mình.</h2>
    </div>
    <div class="help">
      <div>
        <h3>Chia sẻ trang này</h3>
        <p>Gửi cho một người bạn hay cười, hoặc người từng bị mình xin cơm rồi.</p>
        <button class="btn btn-primary" type="button" id="shareBtn">Sao chép đường dẫn</button>
      </div>
      <div>
        <h3>Gửi một lời chúc</h3>
        <p>Nhắn mình vài chữ động viên. Chữ không tốn tiền nhưng no lòng lâu.</p>
      </div>
      <div>
        <h3>Giới thiệu việc làm</h3>
        <p>Có chỗ nào cần người chăm chỉ, nhớ nhắn mình. Xin cần câu còn quý hơn xin cá.</p>
      </div>
    </div>
  </section>

  <section aria-labelledby="h-faq">
    <div class="section-head">
      <p class="eyebrow">Hỏi nhanh đáp gọn</p>
      <h2 id="h-faq">Bạn đang nghĩ gì, mình biết hết.</h2>
    </div>
    <div class="faq">
      <details>
        <summary>Đây có phải trò lừa đảo không?</summary>
        <p>Không hứa lãi, không bán gì, không ép ai. Bạn chỉ chuyển khi thấy muốn. Tên chủ tài khoản hiện ngay phía trên để bạn đối chiếu trước khi gửi.</p>
      </details>
      <details>
        <summary>Mình nên chuyển bao nhiêu?</summary>
        <p>Bao nhiêu cũng được. Một ly trà đá cũng là một lời động viên. Đừng chuyển số khiến bạn phải thắt lưng buộc bụng.</p>
      </details>
      <details>
        <summary>Chuyển xong có cần báo không?</summary>
        <p>Không cần. Nhưng nếu bạn để lại vài chữ trong nội dung chuyển khoản, mình sẽ đọc và cười một mình.</p>
      </details>
      <details>
        <summary>Mình không muốn cho tiền thì sao?</summary>
        <p>Hoàn toàn ổn. Bạn ghé thăm, đọc đến đây và mỉm cười là mình đã vui rồi.</p>
      </details>
    </div>
  </section>

  <footer>
    <p class="hand">Cảm ơn bạn đã ghé qua. Chúc bạn hôm nay ăn ngon.</p>
    <p>Áo có thể rách, lời cảm ơn thì luôn lành lặn.</p>
    <p class="copyright">© 2026 Chu Anh Phuong. Bảo lưu mọi quyền. Lời văn, hình minh họa và bố cục của trang này thuộc về chủ trang. Vui lòng không sao chép hoặc dùng lại cho mục đích thương mại khi chưa được đồng ý. Chia sẻ đường dẫn thì luôn được hoan nghênh.</p>
  </footer>
</div>

<div class="toast-wrap"><div class="toast" id="toast" role="status" aria-live="polite"></div></div>

<script>
/* Thông tin nhận tiền. */
const CONFIG = {
  bank: 'Ngân hàng Bản Việt (BVBank)',
  holder: 'CHU ANH PHUONG',
  account: '9037041118903',
  sample: false
};

const $ = (id) => document.getElementById(id);
const money = (n) => n.toLocaleString('vi-VN') + 'đ';
const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

$('bank').textContent = CONFIG.bank;
$('holder').textContent = CONFIG.holder;
$('account').textContent = CONFIG.account;
$('sampleNote').hidden = !CONFIG.sample;

const custom = $('customAmount');
const radios = Array.from(document.querySelectorAll('input[name="mon"]'));

function current() {
  const r = radios.find((x) => x.checked);
  let amount = r.value === 'custom' ? parseInt(custom.value, 10) || 0 : Number(r.value);
  return { label: r.dataset.label, memo: r.dataset.memo, amount, isCustom: r.value === 'custom' };
}

function render() {
  const c = current();
  const ok = c.amount >= 1000;
  const shown = ok ? money(c.amount) : 'Từ 1.000đ';
  $('amount').textContent = shown;
  $('amountRaw').textContent = ok ? String(c.amount) : '';
  $('memo').textContent = c.memo;
  $('rItem').textContent = c.isCustom ? 'Tuỳ tâm bạn' : c.label;
  $('rPrice').textContent = ok ? shown : '0đ';
  $('rTotal').textContent = ok ? shown : '0đ';
  return { c, ok };
}

function dropCoins(amount) {
  if (reduceMotion) return;
  const n = amount >= 100000 ? 4 : amount >= 50000 ? 3 : amount >= 20000 ? 2 : 1;
  const stage = $('stage');
  for (let i = 0; i < n; i++) {
    const el = document.createElement('span');
    el.className = 'coin';
    el.textContent = '₫';
    el.style.setProperty('--dx', (Math.random() * 60 - 30).toFixed(0) + 'px');
    el.style.animationDelay = (i * 150) + 'ms';
    el.addEventListener('animationend', () => el.remove());
    stage.appendChild(el);
  }
}

function onChoose() {
  const { c, ok } = render();
  if (!ok) return;
  $('caption').textContent = (c.isCustom ? 'Tuỳ tâm bạn' : c.label) + ' · ' + money(c.amount) + '. Cảm ơn bạn nhiều lắm!';
  dropCoins(c.amount);
}

radios.forEach((r) => r.addEventListener('change', onChoose));
custom.addEventListener('input', () => {
  radios.find((x) => x.value === 'custom').checked = true;
  onChoose();
});
render();

let toastTimer;
function toast(msg) {
  const t = $('toast');
  t.textContent = msg;
  t.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => t.classList.remove('show'), 2200);
}

function selectText(el) {
  const range = document.createRange();
  range.selectNodeContents(el);
  const sel = window.getSelection();
  sel.removeAllRanges();
  sel.addRange(range);
}

async function copyText(text, el, okMsg) {
  try {
    await navigator.clipboard.writeText(text);
    toast(okMsg);
  } catch (e) {
    if (el) selectText(el);
    toast('Đã chọn sẵn, bạn bấm Ctrl/Cmd + C để chép nhé');
  }
}

document.querySelectorAll('.copy').forEach((btn) => {
  btn.addEventListener('click', () => {
    const src = $(btn.dataset.copy);
    const text = (src.textContent || '').trim();
    if (!text) { toast('Bạn nhập số tiền từ 1.000đ trở lên nhé'); return; }
    const raw = btn.dataset.copy === 'account' ? text.replace(/\s/g, '') : text;
    const old = btn.textContent;
    copyText(raw, src, 'Đã sao chép');
    btn.textContent = 'Đã chép';
    setTimeout(() => { btn.textContent = old; }, 1600);
  });
});

function shareLink() {
  copyText(window.location.href.split('#')[0], null, 'Đã sao chép đường dẫn. Cảm ơn bạn đã lan tỏa!');
}
$('shareBtn').addEventListener('click', shareLink);
$('shareBtn2').addEventListener('click', shareLink);

/* Lời cảm ơn theo từng mức, giọng người đi xin. */
const THANKS = [
  {
    min: 100000,
    title: 'Cảm ơn bạn, bữa nay có canh có thịt rồi!',
    body: (a) => 'Bạn vừa mời mình ' + a + ', đủ cho một bữa cơm tử tế. Mình xin phép ăn thật ngon để không phụ tấm lòng của bạn.',
    vow: 'Mình hứa ăn đủ rau, nhớ uống nước, và kể lại bữa cơm này như một câu chuyện đẹp.'
  },
  {
    min: 50000,
    title: 'Tô phở này ấm cả bụng lẫn lòng!',
    body: (a) => 'Cảm ơn bạn đã mời mình ' + a + '. Nước dùng thơm, bánh phở mềm, còn lòng tốt của bạn thì thơm hơn cả hành phi.',
    vow: 'Mình hứa húp hết nước dùng và gửi lời cảm ơn đến bạn trong từng thìa.'
  },
  {
    min: 20000,
    title: 'Ổ bánh mì giòn, tấm lòng còn giòn hơn!',
    body: (a) => 'Cảm ơn bạn đã mời mình ' + a + '. Bụng mình vừa khẽ nói "cảm ơn", mình xin phép nói to thay nó.',
    vow: 'Mình hứa ăn từ tốn, không làm rơi vụn nào, vì vụn bánh nào cũng mang theo thiện ý của bạn.'
  },
  {
    min: 1000,
    title: 'Ly trà đá mát lành, cảm ơn bạn nhiều!',
    body: (a) => 'Cảm ơn bạn đã mời mình ' + a + '. Nhỏ thôi nhưng đúng lúc, như cơn gió chiều giữa buổi trưa nắng.',
    vow: 'Mình hứa uống từng ngụm thật chậm và nhớ rằng thế giới này vẫn còn nhiều người dễ thương.'
  }
];

$('doneBtn').addEventListener('click', () => {
  const { c, ok } = render();
  const amount = ok ? c.amount : 0;
  const tier = THANKS.find((t) => amount >= t.min) || THANKS[THANKS.length - 1];
  const shown = ok ? money(amount) : 'một chút lòng tốt';
  /* amount < 1000 dùng mức nhỏ nhất */
  $('thanksTitle').textContent = tier.title;
  $('thanksBody').textContent = tier.body(shown);
  $('thanksVow').textContent = tier.vow;
  const box = $('thanks');
  box.hidden = false;
  $('doneBtn').setAttribute('aria-expanded', 'true');
  $('caption').textContent = 'Đồng xu của bạn đã vào bát. Mình xin chân thành cảm ơn!';
  dropCoins(Math.max(amount, 50000));
  box.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'center' });
  box.focus({ preventScroll: true });
});
</script>
</body>
</html>
